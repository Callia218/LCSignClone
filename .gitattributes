# 全部统一用 LF —— Windows 上默认会把 .sh 写成 CRLF，
# 推到 GitHub 后 CI 里会报 `\r: command not found`
* text=auto eol=lf

*.sh    text eol=lf
*.swift text eol=lf
*.mm    text eol=lf
*.h     text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf

*.png binary
*.ipa binary
*.p12 binary
*.mobileprovision binary
